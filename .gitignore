# Upstream (prime-agent) ignores
node_modules/
dist/
*.log
.DS_Store
*.tsbuildinfo
packages/*/dist/
packages/*/dist-chrome/
packages/*/dist-firefox/
*.cpuprofile
coverage/
.nyc_output/
.pi_config/
tui-debug.log
compaction-results/
.pi_config/
packages/coding-agent/binaries/
.kernel-venv/
.worktrees/

# Environment
.env
.env.*
*.env

# Editor files
.vscode/
.zed/
.idea/
.claude/
*.swp
*.swo
*~

# Python (skills)
__pycache__/
*.py[cod]
*.egg-info/
build/
